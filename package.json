{
  "name": "reclaim-cli",
  "version": "0.1.0",
  "description": "Finds stale local projects and reclaims disk space from their build artifacts",
  "keywords": [
    "cli",
    "disk-space",
    "cleanup",
    "node_modules",
    "derived-data",
    "gradle",
    "xcode",
    "macos"
  ],
  "license": "MIT",
  "author": "Felipe Vasconcelos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favasconcelos/reclaim-cli.git"
  },
  "homepage": "https://github.com/favasconcelos/reclaim-cli#readme",
  "bugs": {
    "url": "https://github.com/favasconcelos/reclaim-cli/issues"
  },
  "type": "module",
  "bin": {
    "reclaim-cli": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "packageManager": "npm@11.19.0"
}
